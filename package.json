{
  "name": "scrapppages",
  "version": "1.0.0",
  "description": "Servidor MCP remoto que expõe uma ferramenta de preparo de prompt para mockups de UI, para ser conectado a clientes MCP como o ChatGPT (a imagem é gerada pelo próprio cliente, sem custo de API).",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.scripts.json",
    "fluxo:teste": "tsx scripts/test-fluxo-completo.ts",
    "fluxo:teste:real": "tsx scripts/test-fluxo-completo.ts --real"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lenixeduardo/scrapppages.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "chatgpt",
    "mockup"
  ],
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/lenixeduardo/scrapppages/issues"
  },
  "homepage": "https://github.com/lenixeduardo/scrapppages#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "playwright-core": "1.56.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2"
  }
}
