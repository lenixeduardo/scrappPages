PORT=3000
HOST=0.0.0.0

# Chave que o cliente MCP (ex: ChatGPT) deve enviar em
# "Authorization: Bearer <valor>" em toda chamada. Gere algo aleatório,
# ex: openssl rand -hex 32
MCP_SHARED_SECRET=

# Chave da API da OpenAI, usada para gerar as imagens de mockup.
OPENAI_API_KEY=

# Opcional. Modelo de geração de imagem da OpenAI. Padrão: gpt-image-1
OPENAI_IMAGE_MODEL=gpt-image-1
