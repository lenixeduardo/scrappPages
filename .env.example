PORT=3000
HOST=0.0.0.0

# Chave que o cliente MCP (ex: ChatGPT) deve enviar em
# "Authorization: Bearer <valor>" em toda chamada. Gere algo aleatório,
# ex: openssl rand -hex 32
MCP_SHARED_SECRET=

# Chave da Google Cloud Platform com "Places API (New)" e "Geocoding API"
# habilitadas. Necessária apenas para a ferramenta
# scrape_businesses_without_website.
# ATENÇÃO: precisa ser a Places API (New). A versão legada foi congelada pelo
# Google em 01/03/2025 e não pode mais ser ativada em projetos novos.
GOOGLE_MAPS_API_KEY=
