PORT=3000
HOST=0.0.0.0

# Chave que o cliente MCP (ex: ChatGPT) deve enviar em
# "Authorization: Bearer <valor>" em toda chamada. Gere algo aleatório,
# ex: openssl rand -hex 32
MCP_SHARED_SECRET=

# Chave da Google Cloud Platform com "Places API" e "Geocoding API"
# habilitadas. Necessária apenas para a ferramenta
# scrape_businesses_without_website.
GOOGLE_MAPS_API_KEY=

# Opcional. Caminho de um binário do Chromium, usado por render_lead_mockup
# para rasterizar o mockup. Se ficar vazio, o playwright-core procura o
# navegador no caminho padrão (ou em PLAYWRIGHT_BROWSERS_PATH).
# CHROMIUM_EXECUTABLE_PATH=
