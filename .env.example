PORT=3000
HOST=0.0.0.0

# Chave que o cliente MCP (ex: ChatGPT) deve enviar em
# "Authorization: Bearer <valor>" em toda chamada. Gere algo aleatório,
# ex: openssl rand -hex 32
MCP_SHARED_SECRET=

# Opcional. Só necessário para usar a tool send_email.
# Se não configurado, a tool responde com erro explicando o que falta.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
